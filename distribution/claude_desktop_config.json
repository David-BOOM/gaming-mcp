{
  "mcpServers": {
    "gaming-mcp": {
      "command": "uv",
      "args": [
        "run",
        "--with",
        "gaming-mcp",
        "gaming-mcp",
        "--adapter",
        "computer_use",
        "--transport",
        "stdio"
      ],
      "env": {
        "PYTHONUNBUFFERED": "1"
      }
    },
    "gaming-mcp-sse": {
      "url": "http://127.0.0.1:8080/sse"
    }
  }
}
